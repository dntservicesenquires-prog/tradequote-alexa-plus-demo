<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#081b35">
<title>TradeQuote AI — Voice Quote Assistant Demo</title>
<style>
:root{--navy:#081b35;--navy2:#102a4b;--blue:#1689ff;--teal:#20c8c3;--pink:#fa5ea8;--ink:#182230;--muted:#667085;--line:#e5eaf1;--bg:#f2f5fa;--white:#fff;--green:#087443;--shadow:0 16px 40px rgba(11,29,55,.12)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font:16px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink)}button,input,textarea,select{font:inherit}button{cursor:pointer}.shell{min-height:100vh;display:flex;flex-direction:column}.top{background:linear-gradient(120deg,var(--navy),#102b50 70%,#193f69);color:#fff;padding:18px 20px 24px}.topInner{max-width:1100px;margin:auto}.brand{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:-.02em;font-size:20px}.brandMark{height:42px;width:42px;border-radius:13px;background:linear-gradient(135deg,var(--teal),#70d7ff);display:grid;place-items:center;color:var(--navy);font-weight:950;font-size:23px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.14em;color:#9fd7f8;font-weight:800}.hero{display:flex;justify-content:space-between;align-items:end;gap:22px;margin-top:32px}.hero h1{font-size:clamp(29px,6vw,44px);line-height:1.08;letter-spacing:-.04em;margin:7px 0 9px;max-width:680px}.hero p{margin:0;color:#d1dfef;max-width:680px}.tag{font-size:12px;padding:8px 12px;border:1px solid rgba(255,255,255,.22);border-radius:999px;color:#d8eaff;white-space:nowrap}.layout{width:min(1100px,100%);margin:24px auto;padding:0 16px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:20px;flex:1}.panel{background:var(--white);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow);overflow:hidden}.panelHead{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.panelHead h2{font-size:17px;margin:0}.status{font-size:12px;color:var(--green);font-weight:700;display:flex;gap:7px;align-items:center}.dot{height:8px;width:8px;background:#18ae6a;border-radius:50%}.conversation{padding:18px;min-height:380px;max-height:54vh;overflow:auto;background:linear-gradient(#f9fbfe,#f6f8fb)}.msg{display:flex;gap:10px;margin:0 0 15px;align-items:flex-start}.avatar{width:32px;height:32px;flex:0 0 32px;border-radius:11px;background:#dff8f6;color:#116a77;display:grid;place-items:center;font-weight:900}.bubble{max-width:88%;padding:11px 14px;border-radius:5px 15px 15px 15px;background:#fff;border:1px solid #e5ebf2;box-shadow:0 4px 12px rgba(30,50,80,.04)}.bubble.user{margin-left:auto;background:#eaf3ff;border-color:#d6e8ff;border-radius:15px 5px 15px 15px}.msg.user{justify-content:flex-end}.bubble p{margin:0}.bubble small{color:var(--muted);display:block;margin-top:5px}.composer{padding:14px 16px 16px;border-top:1px solid var(--line);background:#fff}.composerRow{display:flex;gap:9px;align-items:flex-end}.composer textarea{width:100%;min-height:48px;max-height:120px;resize:vertical;padding:12px 14px;border:1px solid #cfd8e5;border-radius:14px;outline:none}.composer textarea:focus,.field input:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(22,137,255,.12)}.iconBtn,.sendBtn,.primary,.secondary,.ghost{border:0;border-radius:12px;min-height:46px;padding:10px 15px;font-weight:800}.iconBtn{width:48px;padding:0;background:#edf3fb;color:#163b64;font-size:20px}.sendBtn,.primary{background:linear-gradient(115deg,#147ff0,#27a4ff);color:#fff;box-shadow:0 7px 16px rgba(22,137,255,.2)}.secondary{background:#edf4fb;color:#15395d}.ghost{background:transparent;color:#44607f}.suggestions{display:flex;gap:8px;overflow:auto;padding:0 0 10px}.suggestions button{border:1px solid #d8e1ec;background:#fff;border-radius:999px;padding:7px 11px;white-space:nowrap;color:#315170;font-size:12px;font-weight:700}.side{display:flex;flex-direction:column;gap:16px}.quotePanel{padding:20px}.quoteTop{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.quoteTop h2{margin:0;font-size:19px}.badge{border-radius:999px;padding:5px 9px;background:#e7f8f6;color:#11766f;font-size:11px;font-weight:800}.subtle{color:var(--muted);font-size:13px;margin:5px 0 18px}.fieldGrid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.field{min-width:0}.field.full{grid-column:1/-1}.field label{display:block;color:#536273;font-weight:700;font-size:12px;margin:0 0 5px}.field input,.field textarea,.field select{width:100%;padding:10px 11px;border:1px solid #d8e0ea;border-radius:10px;background:#fff;outline:none}.field textarea{min-height:67px;resize:vertical}.amounts{margin-top:18px;border-top:1px solid var(--line);padding-top:11px}.amount{display:flex;justify-content:space-between;gap:12px;padding:6px 0;color:#536273;font-size:14px}.amount strong{color:#263447}.amount.total{border-top:1px solid var(--line);padding-top:12px;margin-top:5px;color:var(--ink);font-size:17px;font-weight:900}.amount.total strong{font-size:22px;color:var(--navy)}.actions{display:flex;gap:8px;margin-top:15px}.actions>*{flex:1}.actions button{min-height:44px}.hint{border:1px dashed #c9d5e4;background:#f8fbff;border-radius:14px;padding:13px 14px;font-size:13px;color:#4e6075}.hint b{color:#183858}.hint ul{margin:7px 0 0;padding-left:19px}.notice{font-size:11px;color:#8190a1;margin:12px 2px 0}.scopeHelp{display:block;color:var(--muted);font-size:11px;margin-top:5px}.saved{padding:15px 18px}.saved h3{margin:0 0 8px;font-size:14px}.savedList{font-size:13px;color:var(--muted)}.savedRow{display:flex;justify-content:space-between;gap:8px;padding:8px 0;border-top:1px solid var(--line);color:var(--ink)}.savedRow span:last-child{font-weight:800}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,15px);opacity:0;pointer-events:none;background:var(--navy);color:white;padding:11px 15px;border-radius:12px;box-shadow:var(--shadow);transition:.2s;z-index:10}.toast.show{opacity:1;transform:translate(-50%,0)}footer{max-width:1100px;margin:0 auto;width:100%;padding:0 18px 20px;color:#8390a0;font-size:11px}.hidden{display:none!important}
@media(max-width:800px){.layout{grid-template-columns:1fr;max-width:680px;margin:17px auto}.hero{align-items:flex-start;flex-direction:column}.tag{white-space:normal}.conversation{max-height:45vh;min-height:300px}.top{padding:15px 17px 22px}.hero{margin-top:24px}.fieldGrid{gap:9px}}
@media(max-width:430px){.composerRow{gap:6px}.iconBtn{width:42px;min-width:42px}.sendBtn{padding:9px 12px}.quotePanel{padding:16px}.fieldGrid{grid-template-columns:1fr 1fr}.panelHead{padding:15px 16px}}
</style>
</head>
<body>
<div class="shell">
<header class="top"><div class="topInner">
  <div class="brand"><div class="brandMark" aria-hidden="true">T</div><div>TradeQuote <span style="color:#54d5d0">AI</span></div></div>
  <div class="hero"><div><div class="eyebrow">Voice-first quoting · prototype</div><h1>Turn a job description into a quote you can review.</h1><p>Describe the work in everyday language. TradeQuote gathers the details, works out the numbers and prepares a draft quote for your approval.</p></div><div class="tag">Alexa+ style simulation · independent prototype</div></div>
</div></header>
<main class="layout">
<section class="panel" aria-label="Quote assistant conversation">
  <div class="panelHead"><h2>Quote assistant</h2><div class="status"><span class="dot"></span>Ready to help</div></div>
  <div class="conversation" id="conversation" aria-live="polite">
    <div class="msg"><div class="avatar">T</div><div class="bubble"><p>Hi! Tell me about the job and I’ll prepare a draft quote. You can include the customer, work, hours, hourly rate, materials, markup and VAT.</p><small>You review every detail before saving or sharing.</small></div></div>
  </div>
  <div class="composer">
    <div class="suggestions"><button type="button" id="sampleBtn">Try a sample bathroom quote</button><button type="button" id="projectBtn">Start a multi-trade project</button></div>
    <div class="composerRow"><button class="iconBtn" id="voiceBtn" type="button" aria-label="Speak your request" title="Speak your request">🎙</button><textarea id="request" placeholder="For example: Quote Jane Smith for repainting two bedrooms…" aria-label="Describe the job"></textarea><button class="sendBtn" id="sendBtn" type="button">Prepare</button></div>
  </div>
</section>
<aside class="side">
  <section class="panel quotePanel" aria-label="Draft quote">
    <div class="quoteTop"><h2>Draft quote</h2><span class="badge" id="quoteState">Waiting for details</span></div>
    <p class="subtle" id="quoteSub">Your draft stays on this device until you save it.</p>
    <div class="fieldGrid">
      <div class="field"><label for="customer">Customer</label><input id="customer" placeholder="Customer name" autocomplete="off"></div>
      <div class="field"><label for="job">Job title</label><input id="job" placeholder="Work description"></div>
      <div class="field"><label for="hours">Labour hours</label><input id="hours" type="number" min="0" step="0.5" value="0"></div>
      <div class="field"><label for="rate">Hourly rate (£)</label><input id="rate" type="number" min="0" step="0.01" value="35"></div>
      <div class="field"><label for="materials">Materials (£)</label><input id="materials" type="number" min="0" step="0.01" value="0"></div>
      <div class="field"><label for="markup">Markup (%)</label><input id="markup" type="number" min="0" step="1" value="15"></div>
      <div class="field"><label for="vat">VAT</label><select id="vat"><option value="0">No VAT</option><option value="20">Add 20% VAT</option></select></div>
      <div class="field"><label for="deposit">Deposit (%)</label><input id="deposit" type="number" min="0" max="100" step="5" value="0"></div>
      <div class="field full"><label for="scopePreset">Quick scope options</label><select id="scopePreset" aria-label="Choose a scope of work template"><option value="">Choose a starting point…</option><option value="Remove existing kitchen units and fittings. Install and level new cabinets, fit the worktop, sink and tap, connect agreed appliances, seal joints and leave the work area tidy.">Full kitchen installation</option><option value="Remove the existing worktop, sink and waste. Fit and seal the new worktop, install the sink and tap, reconnect the waste and water, test for leaks and clear away removed materials.">Worktop, sink and waste replacement</option><option value="Assemble, position and secure the kitchen units. Adjust doors and drawers, fit handles and plinths, and leave the area clean and ready for the next trade.">Kitchen unit fitting</option><option value="Remove agreed existing bathroom fittings. Install the new suite, connect plumbing, seal around fittings, test operation and leave the work area tidy. Tiling and electrical work are excluded unless listed separately.">Full bathroom installation</option><option value="Replace the agreed bathroom fittings and refresh visible sealant and finishes. Keep existing plumbing positions where possible; repairs, tiling and electrical work are excluded unless listed separately.">Bathroom refresh</option><option value="Investigate the reported plumbing issue, isolate the supply if needed, repair or replace the agreed parts, test for leaks and explain any further work required.">Plumbing repair</option><option value="Prepare the agreed walls or floor, apply tile adhesive, set and grout tiles, finish edges and remove waste. Tile supply and substrate repairs are included only if listed in the materials or notes.">Tiling</option><option value="Protect nearby surfaces, prepare and fill the agreed surfaces, apply the specified number of paint coats and tidy the work area. Major repairs and extra coats are excluded unless listed.">Painting and decorating</option><option value="Remove the agreed existing floor covering, prepare the subfloor and install the selected flooring and trims. Disposal, levelling and repairs are included only if listed in the quote.">Flooring installation</option><option value="Complete the agreed electrical installation or replacement, test the work and provide the relevant certification where required. Any additional circuits or remedial work will be quoted separately.">Electrical work</option><option value="Complete the listed repair tasks, supply and fit agreed materials, test the completed work and tidy the work area. Any additional work will be agreed and priced separately.">General repairs</option></select><small class="scopeHelp">Pick a template, then edit the scope below to match this job.</small></div>
      <div class="field full"><label for="scope">Scope of work</label><textarea id="scope" placeholder="What work is included?"></textarea></div>
    </div>
    <div class="projectEditor hidden" id="projectEditor" style="margin-top:14px;border:1px solid var(--line);border-radius:13px;padding:12px;background:#f8fbff">
      <strong style="font-size:13px">Project stages</strong><p class="subtle" style="margin:3px 0 10px">Adjust each trade stage; the project total updates automatically.</p>
      <div id="stageList"></div><button type="button" class="secondary" id="addStage" style="margin-top:8px">+ Add trade stage</button>
    </div>
    <div class="amounts" aria-live="polite">
      <div class="amount"><span>Labour</span><strong id="labourTotal">£0.00</strong></div>
      <div class="amount"><span>Materials</span><strong id="materialsTotal">£0.00</strong></div>
      <div class="amount"><span>Markup</span><strong id="markupTotal">£0.00</strong></div>
      <div class="amount" id="vatRow"><span>VAT</span><strong id="vatTotal">£0.00</strong></div>
      <div class="amount total"><span>Quote total</span><strong id="grandTotal">£0.00</strong></div>
      <div class="amount" id="depositRow"><span>Deposit due</span><strong id="depositTotal">£0.00</strong></div>
    </div>
    <div class="actions"><button type="button" class="secondary" id="saveBtn">Save draft</button><button type="button" class="primary" id="printBtn">Print / PDF</button></div>
    <p class="notice">Demo only: prices are examples. Check local rates, tax treatment and agreed scope before sending any quote.</p>
  </section>
  <section class="panel saved"><h3>Saved drafts on this device</h3><div class="savedList" id="savedList">No drafts saved yet.</div></section>
  <div class="hint"><b>Prototype notes</b><ul><li>No external AI service or customer data is sent.</li><li>Voice input depends on browser speech recognition support.</li><li>This is a simulated assistant, not an official Alexa+ connection.</li></ul></div>
</aside>
</main>
<footer>TradeQuote AI is an independent prototype. It is not affiliated with or endorsed by Amazon or Alexa+.</footer>
</div>
<div class="toast" id="toast" role="status"></div>
<script>
(()=>{
 const $=id=>document.getElementById(id), money=n=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(Number(n)||0);
 const fields=['customer','job','hours','rate','materials','markup','vat','deposit','scope'];
 let toastTimer, projectMode=false, projectStages=[];
 function toast(text){const t=$('toast');t.textContent=text;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2300)}
 function addMessage(text,who='assistant',note=''){const row=document.createElement('div');row.className='msg '+(who==='user'?'user':'');if(who==='assistant'){const av=document.createElement('div');av.className='avatar';av.textContent='T';row.append(av)}const b=document.createElement('div');b.className='bubble'+(who==='user'?' user':'');const p=document.createElement('p');p.textContent=text;b.append(p);if(note){const small=document.createElement('small');small.textContent=note;b.append(small)}row.append(b);$('conversation').append(row);$('conversation').scrollTop=$('conversation').scrollHeight}
 function val(id){return Number($(id).value)||0}
 function totals(){const labour=val('hours')*val('rate'),materials=val('materials'),base=labour+materials,markup=base*val('markup')/100,sub=base+markup,vat=sub*val('vat')/100,total=sub+vat,deposit=total*val('deposit')/100;return {labour,materials,markup,vat,total,deposit}}
 function calculateProject(){const labour=projectStages.reduce((n,s)=>n+(Number(s.labour)||0),0),materials=projectStages.reduce((n,s)=>n+(Number(s.materials)||0),0),base=labour+materials,markup=base*val('markup')/100,sub=base+markup,vat=sub*val('vat')/100,total=sub+vat,deposit=total*val('deposit')/100;return {labour,materials,markup,vat,total,deposit}}
 function update(){const t=projectMode?calculateProject():totals();$('labourTotal').textContent=money(t.labour);$('materialsTotal').textContent=money(t.materials);$('markupTotal').textContent=money(t.markup);$('vatTotal').textContent=money(t.vat);$('grandTotal').textContent=money(t.total);$('depositTotal').textContent=money(t.deposit);$('vatRow').classList.toggle('hidden',!t.vat);$('depositRow').classList.toggle('hidden',!val('deposit'));const ready=$('customer').value.trim()&&$('job').value.trim()&&(!projectMode||projectStages.some(s=>(Number(s.labour)||0)+(Number(s.materials)||0)>0));$('quoteState').textContent=ready?'Ready to review':'Waiting for details';$('quoteSub').textContent=ready?(projectMode?'Review each trade stage and the combined project total.':'Check the customer, scope and price before saving or sharing.'):'Your draft stays on this device until you save it.';}
 function parseRequest(text){
   const d={};
   let m=text.match(/\bfor\s+([A-Z][a-z]+(?:[-'][A-Za-z]+)?(?:\s+[A-Z][a-z]+(?:[-'][A-Za-z]+)?){0,2})/);if(m)d.customer=m[1].trim();
   m=text.match(/\b(?:to|job:|work:|scope:)\s+(.+?)(?:[.;\n]|\s+\d+(?:\.\d+)?\s*(?:labou?r\s*)?hours?\b|$)/i);if(m)d.job=m[1].replace(/^(quote|prepare a quote|create a quote)\s+/i,'').trim();
   m=text.match(/(\d+(?:\.\d+)?)\s*(?:labou?r\s*)?hours?\b/i);if(m)d.hours=m[1];
   m=text.match(/(?:at\s*)?£\s*(\d+(?:\.\d+)?)\s*(?:per|\/)\s*hour\b/i);if(m)d.rate=m[1];
   m=text.match(/£\s*(\d+(?:\.\d+)?)\s*(?:for\s*)?materials\b/i);if(m)d.materials=m[1];
   m=text.match(/(\d+(?:\.\d+)?)\s*%\s*(?:markup|mark-up|profit)\b/i);if(m)d.markup=m[1];
   if(/\bno\s+vat\b|\bwithout\s+vat\b|\bzero\s+vat\b/i.test(text))d.vat='0';else if(/\bvat\b/i.test(text))d.vat='20';
   m=text.match(/(\d+(?:\.\d+)?)\s*%\s*(?:deposit|upfront|up front)\b/i);if(m)d.deposit=m[1];
   if(d.job){d.scope=d.job.charAt(0).toUpperCase()+d.job.slice(1)}
   return d;
 }
 function process(text){const clean=text.trim();if(!clean)return;if(projectMode){projectMode=false;projectStages=[];$('projectEditor').classList.add('hidden')}addMessage(clean,'user');const d=parseRequest(clean);for(const [k,v] of Object.entries(d))$(k).value=v;update();const missing=[];if(!$('customer').value.trim())missing.push('customer name');if(!$('job').value.trim())missing.push('work description');if(val('hours')<=0)missing.push('labour hours');if(!d.rate&&!val('rate'))missing.push('hourly rate');if(missing.length){addMessage(`I’ve filled in what I could. Please add or correct the ${missing.join(', ')} in the draft card. The totals update as you edit.`,'assistant','Nothing is saved or sent until you choose an action.')}else{const t=totals();const dep=val('deposit')?` The ${val('deposit')}% deposit would be ${money(t.deposit)}.`:'';addMessage(`I’ve prepared a draft for ${$('customer').value.trim()}: ${$('job').value.trim()}. Labour is ${money(t.labour)} and materials are ${money(t.materials)}. With ${val('markup')}% markup${val('vat')?' and '+val('vat')+'% VAT':''}, the total is ${money(t.total)}.${dep} Please check the details on the right before saving or printing.`,'assistant','Draft only · review all figures and terms before sending.')}$('request').value='';}
 fields.forEach(id=>$(id).addEventListener('input',update));$('vat').addEventListener('change',update);
 $('scopePreset').addEventListener('change',()=>{if($('scopePreset').value){$('scope').value=$('scopePreset').value;$('scope').focus()}$('scopePreset').value=''});
 $('sendBtn').addEventListener('click',()=>process($('request').value));$('request').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();process($('request').value)}});
 $('sampleBtn').addEventListener('click',()=>process('Prepare a quote for Jane Smith to repaint two bedrooms. 18 labour hours at £35 per hour, £220 materials, 15% markup, no VAT. Ask for a 50% deposit.'));
 function renderStages(){ $('stageList').innerHTML=projectStages.map((s,i)=>`<div class="stageRow" data-stage="${i}" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px 0;border-top:1px solid var(--line)"><div class="field"><label>Trade</label><input data-stage-field="trade" value="${escapeHtml(s.trade)}"></div><div class="field"><label>Area / phase</label><input data-stage-field="area" value="${escapeHtml(s.area)}"></div><div class="field"><label>Labour (£)</label><input data-stage-field="labour" type="number" min="0" step="0.01" value="${s.labour}"></div><div class="field"><label>Materials (£)</label><input data-stage-field="materials" type="number" min="0" step="0.01" value="${s.materials}"></div><button type="button" class="ghost" data-remove-stage="${i}" style="grid-column:1/-1;text-align:left;padding:3px 0;min-height:0">Remove stage</button></div>`).join('');document.querySelectorAll('[data-stage-field]').forEach(el=>el.addEventListener('input',()=>{const i=+el.closest('[data-stage]').dataset.stage,k=el.dataset.stageField;projectStages[i][k]=['labour','materials'].includes(k)?Number(el.value||0):el.value;update()}));document.querySelectorAll('[data-remove-stage]').forEach(el=>el.addEventListener('click',()=>{projectStages.splice(+el.dataset.removeStage,1);renderStages();update()})) }
 $('projectBtn').addEventListener('click',()=>{projectMode=true;$('projectEditor').classList.remove('hidden');$('customer').value='Alex Brown';$('job').value='Bathroom renovation';$('scope').value='Plumbing, tiling and decorating across one bathroom';$('hours').value='0';$('materials').value='0';projectStages=[{trade:'Plumbing',area:'Bathroom',labour:350,materials:240},{trade:'Tiling',area:'Bathroom walls and floor',labour:420,materials:180},{trade:'Decorating',area:'Bathroom finish',labour:280,materials:75}];$('markup').value='15';$('vat').value='0';$('deposit').value='50';renderStages();update();const t=calculateProject();addMessage('Prepare a multi-trade bathroom renovation quote for Alex Brown. Include plumbing, tiling and decorating, with 15% markup, no VAT and a 50% deposit.','user');addMessage(`I’ve separated the work into three editable stages. The combined draft total is ${money(t.total)}, with a ${money(t.deposit)} deposit. Change any stage amount before saving.`,'assistant','Illustrative sample figures · confirm every amount with the customer.');});
 $('addStage').addEventListener('click',()=>{projectStages.push({trade:'New trade',area:'',labour:0,materials:0});renderStages();update()});
 $('saveBtn').addEventListener('click',()=>{if(!$('customer').value.trim()||!$('job').value.trim()){toast('Add a customer and job before saving');return}const draft={id:Date.now(),customer:$('customer').value.trim(),job:$('job').value.trim(),scope:$('scope').value,hours:val('hours'),rate:val('rate'),materials:val('materials'),markup:val('markup'),vat:val('vat'),deposit:val('deposit'),totals:projectMode?calculateProject():totals(),projectMode,stages:projectMode?projectStages:[],savedAt:new Date().toLocaleString('en-GB')};let list=[];try{list=JSON.parse(localStorage.getItem('tradequote_alexa_drafts')||'[]')}catch{}list.unshift(draft);localStorage.setItem('tradequote_alexa_drafts',JSON.stringify(list.slice(0,8)));renderSaved();addMessage(`Saved draft ${draft.customer} · ${draft.job} on this device. You can reopen it below.`,'assistant');toast('Draft saved on this device')});
 $('printBtn').addEventListener('click',()=>{if(!$('customer').value.trim()||!$('job').value.trim()){toast('Add a customer and job first');return}window.print()});
 function renderSaved(){let list=[];try{list=JSON.parse(localStorage.getItem('tradequote_alexa_drafts')||'[]')}catch{}$('savedList').innerHTML=list.length?list.map((q,i)=>`<div class="savedRow"><button class="ghost" data-load="${i}" style="text-align:left;padding:4px 0;min-height:0">${escapeHtml(q.customer)} · ${escapeHtml(q.job)}</button><span>${money(q.totals.total)}</span></div>`).join(''):'No drafts saved yet.';document.querySelectorAll('[data-load]').forEach(b=>b.addEventListener('click',()=>{const q=list[+b.dataset.load];projectMode=!!q.projectMode;$('projectEditor').classList.toggle('hidden',!projectMode);for(const k of fields){if(q[k]!==undefined)$(k).value=q[k]}projectStages=q.stages||[];if(projectMode)renderStages();update();addMessage(`Reopened the saved draft for ${q.customer}.`,'assistant')}))}
 function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
 $('voiceBtn').addEventListener('click',()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast('Voice input is not available in this browser. You can type your request.');return}const r=new SR();r.lang='en-GB';r.interimResults=false;r.onresult=e=>{$('request').value=e.results[0][0].transcript;process($('request').value)};r.onerror=()=>toast('Could not hear that. Please try typing your request.');r.start()});
 function printStyles(){const s=document.createElement('style');s.textContent='@media print{body{background:#fff}.top,.panel:first-child,.saved,.hint,footer,.actions,.notice,.toast{display:none!important}.layout{display:block;width:100%;margin:0;padding:0}.side{display:block}.quotePanel{border:0;box-shadow:none}.quotePanel .fieldGrid{display:none}.quotePanel .subtle{margin-bottom:8px}.panel{break-inside:avoid}.amounts{max-width:500px}.quoteTop h2{font-size:24px}.quotePanel:before{content:"TRADEQUOTE · DRAFT QUOTE";display:block;font-weight:900;color:#17395d;margin-bottom:20px}.projectEditor{display:block!important;background:#fff!important}.projectEditor .subtle{margin-bottom:8px!important}.projectEditor button{display:none!important}.stageRow{break-inside:avoid}.stageRow input{border:0!important;padding:2px!important;color:#182230!important;background:transparent!important}.stageRow .field label{font-size:10px}.stageRow{grid-template-columns:1fr 1fr!important}}';document.head.append(s)}
 printStyles();renderSaved();update();
})();
